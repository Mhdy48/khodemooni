    "globals": "^17.14.0",
    "parse5": "^7.3.0",
    "prettier": "^3.10.1",
    "proper-lockfile": "^4.1.2",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
